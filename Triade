            mainFrame.Size = UDim2.new(0, 180, 0, 55)
            toggleButton.Text = "▶ Открыть меню"
        end
    end)
    
    -- Fix: Force update layout
    task.wait(0.1)
    menuHeight = #menuItems * 35 + 10
    
    return {
        ScreenGui = screenGui,
        CreateToggle = createMobileToggle,
        CreateColorPicker = createColorPicker,
        CreateSlider = createSlider,
        MainFrame = mainFrame,
        UpdateMenuHeight = function()
            menuHeight = #menuItems * 35 + 10
