end

-- Simple ESP for mobile (using BillboardGui instead of Drawing)
local MobileESP = {
    enabled = false,
    players = {},
    objects = {},
    settings = {
        showPlayers = true,
        showObjects = true,
        playerColor = Color3.fromRGB(255, 50, 50),
        objectColor = Color3.fromRGB(50, 255, 50),
        maxDistance = 500,
        showDistance = true,
        showName = true
    }
}

function MobileESP:CreateBillboardESP(target, text, color)
    if not target or not target:IsA("BasePart") then return end
    
    -- Remove existing ESP if any
    local existing = target:FindFirstChild("MobileESP_Billboard")
    if existing then existing:Destroy() end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MobileESP_Billboard"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.MaxDistance = self.settings.maxDistance
    billboard.Parent = target
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "ESP_Text"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = color
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = billboard
    
    return billboard
end

function MobileESP:UpdatePlayerESP(player)
    if not player or not player.Character then return end
    
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    
    local distance = (Camera.CFrame.p - head.Position).Magnitude
    if distance > self.settings.maxDistance then
        local existing = head:FindFirstChild("MobileESP_Billboard")
        if existing then existing.Enabled = false end
        return
    end
    
    local text = ""
    if self.settings.showName then
        text = player.Name
    end
    if self.settings.showDistance then
        text = text .. (text == "" and "" or "\n") .. math.floor(distance) .. " studs"
    end
    
    local esp = self:CreateBillboardESP(head, text, self.settings.playerColor)
    if esp then
        esp.Enabled = self.enabled and self.settings.showPlayers
        self.players[player] = esp
    end
end

function MobileESP:UpdateObjectESP(object)
    if not object or not object:IsA("Model") then return end
    
    local primary = object.PrimaryPart or object:FindFirstChild("Head") or object:FindFirstChildOfClass("BasePart")
    if not primary then return end
    
    local distance = (Camera.CFrame.p - primary.Position).Magnitude
    if distance > self.settings.maxDistance then
        local existing = primary:FindFirstChild("MobileESP_Billboard")
        if existing then existing.Enabled = false end
        return
    end
    
    local objectName = object.Name
    local text = objectName
    if self.settings.showDistance then
        text = text .. "\n" .. math.floor(distance) .. " studs"
    end
    
    local esp = self:CreateBillboardESP(primary, text, self.settings.objectColor)
    if esp then
        esp.Enabled = self.enabled and self.settings.showObjects
        self.objects[object] = esp
    end
end

function MobileESP:ScanWorkspace()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            self:UpdatePlayerESP(player)
        end
    end
    
    -- Scan for objects (simple detection)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
            -- Check if it's an object we want to show
            if obj.Name:find("Tree") or obj.Name:find("Stone") or obj.Name:find("Iron") or 
               obj.Name:find("Backpack") or obj.Name:find("Totem") or
               obj.Name:find("ATV") or obj.Name:find("Tesla") or
               obj.Name:find("Gas") or obj.Name:find("Claim") then
                self:UpdateObjectESP(obj)
            end
        end
    end
end

function MobileESP:Start()
    if self.running then return end
    self.running = true
    
    -- Initial scan
    self:ScanWorkspace()
    
    -- Update players when their character changes
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            if self.enabled then
                task.wait(0.5)
                self:UpdatePlayerESP(player)
            end
        end)
    end)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                if self.enabled then
                    task.wait(0.5)
                    self:UpdatePlayerESP(player)
                end
            end)
        end
    end
    
    -- Periodic updates
    RunService.Heartbeat:Connect(function()
        if not self.enabled then return end
        
        -- Update existing ESPs
        for player, esp in pairs(self.players) do
            if player and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head and esp and esp.Parent == head then
                    local distance = (Camera.CFrame.p - head.Position).Magnitude
                    esp.Enabled = distance <= self.settings.maxDistance
                    
                    if esp.Enabled then
                        local textLabel = esp:FindFirstChild("ESP_Text")
                        if textLabel then
                            local text = ""
                            if self.settings.showName then
                                text = player.Name
                            end
                            if self.settings.showDistance then
                                text = text .. (text == "" and "" or "\n") .. math.floor(distance) .. " studs"
                            end
                            textLabel.Text = text
                        end
                    end
                else
                    self.players[player] = nil
                end
            else
                self.players[player] = nil
            end
        end
        
        -- Update objects
        for obj, esp in pairs(self.objects) do
            if obj and obj.Parent then
                local primary = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                if primary and esp and esp.Parent == primary then
                    local distance = (Camera.CFrame.p - primary.Position).Magnitude
                    esp.Enabled = distance <= self.settings.maxDistance
                    
                    if esp.Enabled then
                        local textLabel = esp:FindFirstChild("ESP_Text")
                        if textLabel then
                            local text = obj.Name
                            if self.settings.showDistance then
                                text = text .. "\n" .. math.floor(distance) .. " studs"
                            end
                            textLabel.Text = text
                        end
                    end
                else
                    self.objects[obj] = nil
                end
            else
                self.objects[obj] = nil
            end
        end
        
        -- Rescan every 5 seconds
        if tick() - (self.lastScan or 0) > 5 then
            self:ScanWorkspace()
            self.lastScan = tick()
        end
    end)
end

function MobileESP:SetEnabled(state)
    self.enabled = state
    
    -- Update all ESPs
    for _, esp in pairs(self.players) do
        if esp then
            esp.Enabled = state and self.settings.showPlayers
        end
    end
    
    for _, esp in pairs(self.objects) do
        if esp then
            esp.Enabled = state and self.settings.showObjects
        end
    end
    
    if state and not self.running then
        self:Start()
    end
end

function MobileESP:Cleanup()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local esp = head:FindFirstChild("MobileESP_Billboard")
                if esp then esp:Destroy() end
            end
        end
    end
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local primary = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
            if primary then
                local esp = primary:FindFirstChild("MobileESP_Billboard")
                if esp then esp:Destroy() end
            end
        end
    end
    
    self.players = {}
    self.objects = {}
end

