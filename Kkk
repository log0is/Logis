function GetClosestTargetInFOV()
    if not silentAimActive then return nil end
    
    local closestTarget = nil
    local closestDistance = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for model, data in pairs(espPlayers) do
        -- Проверяем только игроков с ESP если включен режим
        if aimOnESPPlayersOnly and not loaded_plrs[model] then
            continue
        end
        
        if model and model:FindFirstChild("Head") then
            local head = model.Head
            local screenPoint = Camera:WorldToViewportPoint(head.Position)
            
            if screenPoint.Z > 0 then
                local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                local distanceFromCenter = (screenPos - screenCenter).Magnitude
                
                -- Проверяем что цель в пределах FOV
                if distanceFromCenter <= baseRadius then
                    local distanceToPlayer = (head.Position - Camera.CFrame.Position).Magnitude
                    
                    if distanceToPlayer < closestDistance then
                        closestDistance = distanceToPlayer
                        closestTarget = model
                    end
                end
            end
        end
    end
    
    return closestTarget, closestDistance
end

