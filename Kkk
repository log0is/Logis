-- Функция для добавления игрока в список аима
local function AddPlayerToAimList(playerModel, isSleeping)
    if not playerModel then return end
    
    local playerId = nil
    for _, v in pairs(PlayerReg) do
        if v and v.model == playerModel then
            playerId = v.id
            break
        end
    end
    
    if not playerId then
        local plr = Players:GetPlayerFromCharacter(playerModel)
        playerId = plr and plr.UserId
    end
    
    if playerId then
        espPlayers[playerModel] = {
            model = playerModel,
            id = playerId,
            sleeping = isSleeping,
            lastUpdate = tick()
        }
        print("[AIM] Добавлен в список аима: " .. playerModel.Name .. (isSleeping and " (SLEEPING)" or ""))
    end
end

-- Функция для удаления игрока из списка аима
local function RemovePlayerFromAimList(playerModel)
    if espPlayers[playerModel] then
        print("[AIM] Удален из списка аима: " .. playerModel.Name)
        espPlayers[playerModel] = nil
    end
end

