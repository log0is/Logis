local lastDebugUpdate = 0
local hookInstalled = false

RunService.RenderStepped:Connect(function(deltaTime)
    -- Обновляем FOV круг
    local fovScale = (math.tan(math.rad(50)) / math.tan(math.rad(Camera.FieldOfView))) ^ 0.35
    local newRadius = baseRadius * fovScale
    
    fovCircle.Size = UDim2.new(0, newRadius * 2, 0, newRadius * 2)
    fovCircle.Position = UDim2.new(0.5, -newRadius, 0.5, -newRadius)
    
    -- Обновляем информацию
    lastDebugUpdate = lastDebugUpdate + deltaTime
    if lastDebugUpdate > 0.5 then
        local targetCount = 0
        for _ in pairs(espPlayers) do
            targetCount = targetCount + 1
        end
        
        aimInfo.Text = string.format(
            "Silent Aim: %s\nMode: ESP Players Only\nTargets: %d\nFOV: %d",
            silentAimActive and "ON" : "OFF",
            targetCount,
            baseRadius
        )
        
        lastDebugUpdate = 0
    end
    
    -- Пробуем установить хук если еще не установлен
    if not hookInstalled then
        hookInstalled = pcall(SetupAimHook)
    end
end)

