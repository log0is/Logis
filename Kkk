            local distance = model:FindFirstChild("Head") and (model.Head.Position - Camera.CFrame.Position).Magnitude or 0
            print(string.format("%d. %s (Sleeping: %s, Distance: %.1f)", 
                i, model.Name, data.sleeping and "Yes" : "No", distance))
            i = i + 1
        end
    end,
    
    ReinstallHook = function()
        hookInstalled = false
        print("Переустановка хука...")
    end
}

