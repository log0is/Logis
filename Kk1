-- Функция для получения игроков из ESP
local function GetESPTargets()
    local targets = {}
    
    -- Ищем всех живых игроков кроме себя
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local head = player.Character:FindFirstChild("Head")
            
            if humanoid and humanoid.Health > 0 and head then
                targets[player.Character] = true
            end
        end
    end
    
    return targets
end

-- Найти ближайшую цель в FOV
local function FindClosestTarget()
    if not Camera then return nil end
    
    local closestTarget = nil
    local closestDistance = _G.CurrentFOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for character, _ in pairs(GetESPTargets()) do
        local head = character:FindFirstChild("Head")
        if head then
            local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
            
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                
                if distance < closestDistance then
                    closestDistance = distance
                    closestTarget = character
                end
            end
        end
    end
    
    return closestTarget
end

-- Плавное наведение
local function SmoothAim(target)
    if not target or not Camera then return end
    
    local head = target:FindFirstChild("Head")
    if not head then return end
    
    local currentCF = Camera.CFrame
    local targetPos = head.Position
    local direction = (targetPos - currentCF.Position).Unit
    
    Camera.CFrame = CFrame.new(currentCF.Position, currentCF.Position + direction)
end

-- Включить/выключить аимбот
function ToggleAimbot()
    _G.AimbotEnabled = not _G.AimbotEnabled
    
    if _G.AimbotEnabled then
        print("Aimbot ВКЛЮЧЕН")
        
        -- Создаем FOV круг если его нет
        if not FOVCircle and Drawing then
            FOVCircle = Drawing.new("Circle")
            FOVCircle.Visible = true
            FOVCircle.Thickness = 1
            FOVCircle.Color = Color3.fromRGB(255, 0, 0)
            FOVCircle.Radius = _G.CurrentFOV
            FOVCircle.Filled = false
        end
        
        -- Запускаем цикл прицеливания
        aimbotConnection = RunService.RenderStepped:Connect(function()
            if not _G.AimbotEnabled then return end
            
            local target = FindClosestTarget()
            if target then
                SmoothAim(target)
                _G.AimbotTarget = target
            else
                _G.AimbotTarget = nil
            end
        end)
    else
        print("Aimbot ВЫКЛЮЧЕН")
        
        -- Удаляем FOV круг
        if FOVCircle then
            FOVCircle:Remove()
            FOVCircle = nil
        end
        
        -- Отключаем соединение
        if aimbotConnection then
            aimbotConnection:Disconnect()
            aimbotConnection = nil
        end
        
        _G.AimbotTarget = nil
    end
end

-- Обновить FOV
function UpdateFOV()
    if _G.CurrentFOV < 150 then
        _G.CurrentFOV = _G.CurrentFOV + 10
    else
        _G.CurrentFOV = 30
    end
    
    if FOVCircle then
        FOVCircle.Radius = _G.CurrentFOV
    end
    
    print("FOV изменен на: " .. _G.CurrentFOV)
end

