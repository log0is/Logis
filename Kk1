-- Инициализируем ESP (упрощенная версия)
local function InitializeSimpleESP()
    if not Drawing then 
        warn("Drawing не доступен, ESP может не работать")
        return 
    end
    
    -- Простой ESP для примера
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            spawn(function()
                wait(1)
                
                -- Создаем Highlight для игрока
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESP_" .. player.Name
                highlight.FillColor = Color3.fromRGB(255, 50, 50)
                highlight.FillTransparency = 0.7
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Parent = container
                
                -- Обновляем позицию
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    if not _G.ESPEnabled then
                        highlight.Enabled = false
                        return
                    end
                    
                    if player.Character then
                        highlight.Adornee = player.Character
                        highlight.Enabled = true
                        
                        -- Меняем цвет если это цель аимбота
                        if _G.AimbotTarget == player.Character then
                            highlight.FillColor = Color3.fromRGB(50, 255, 50)
                        else
                            highlight.FillColor = Color3.fromRGB(255, 50, 50)
                        end
                    else
                        highlight.Enabled = false
                    end
                end)
                
                -- Чистка при выходе игрока
                player:GetPropertyChangedSignal("Parent"):Connect(function()
                    if not player.Parent then
                        connection:Disconnect()
                        highlight:Destroy()
                    end
                end)
            end)
        end
    end
    
    -- Новые игроки
    Players.PlayerAdded:Connect(function(player)
        wait(1)
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_" .. player.Name
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Parent = container
        
        RunService.RenderStepped:Connect(function()
            if not _G.ESPEnabled then
                highlight.Enabled = false
                return
            end
            
            if player.Character then
                highlight.Adornee = player.Character
                highlight.Enabled = true
            else
                highlight.Enabled = false
            end
        end)
    end)
    
    print("Простой ESP инициализирован")
end

