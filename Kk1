local function worldToScreen(world)
    local screen, inBounds = Camera:WorldToViewportPoint(world)
    return Vector2.new(math.floor(screen.X), math.floor(screen.Y)), inBounds, screen.Z
end

local function calculateCornersSimple(head, hrp)
    local head_position = worldToScreen(head.Position - Vector3.new(0, 0.5, 0))
    local leg_position = worldToScreen(hrp.Position - Vector3.new(0, 3.5, 0))
    local headx, heady = head_position.X, head_position.Y
    local legx, legy = leg_position.X, leg_position.Y
    local height = legy - heady
    local width = height / 3.6
    return {
        topLeft = Vector2.new(headx - width, heady),
        topRight = Vector2.new(headx + width, heady),
        bottomLeft = Vector2.new(headx - width, legy),
        bottomRight = Vector2.new(headx + width, legy)
    }
end

local function getRainbowColor()
    local time = tick() * 0.5
    local r = (math.sin(time) + 1) / 2
    local g = (math.sin(time + 2 * math.pi / 3) + 1) / 2
    local b = (math.sin(time + 4 * math.pi / 3) + 1) / 2
    return Color3.new(r, g, b)
end

local function getPlayerIdFromModel(model)
    if not model then return nil, false end
    for _, player in next, PlayerReg do
        if player and player.model == model then
            return player.id, player.sleeping
        end
    end
    local plr = Players:GetPlayerFromCharacter(model)
    return plr and plr.UserId, false
end

local function createDrawingObject(type, properties)
    if not Drawing then return nil end
    local obj = Drawing.new(type)
    for prop, value in pairs(properties) do
        obj[prop] = value
    end
    return obj
end

local function create_player_esp(model)
    if not model or not model:IsA("Model") then return end
    if not model:FindFirstChild("Head") or not model:FindFirstChild("LowerTorso") then return end
    
    local player = Players:GetPlayerFromCharacter(model)
    if player == LocalPlayer then return end
    
    -- Добавляем в список ESP игроков
    esp_players[model] = true
    
    local playerId, isSleeping = getPlayerIdFromModel(model)
    local playerName = player and player.Name or "Player"
    
    -- Создаем ESP объекты если Drawing доступен
    if Drawing then
        loaded_plrs[model] = {
            obj = {},
            chams_object = Instance.new("Highlight", container),
            connection = nil
        }
        
        local plr = loaded_plrs[model]
        local settings = esp_table.settings.enemy
        
        -- Создаем Drawing объекты
        plr.obj.box = createDrawingObject("Square", {
            Filled = false,
            Thickness = 1,
            Visible = false
        })
        
        plr.obj.box_fill = createDrawingObject("Square", {
            Filled = true,
            Visible = false
        })
        
        plr.obj.box_outline = createDrawingObject("Square", {
            Filled = false,
            Thickness = 3,
            Visible = false,
            ZIndex = -1
        })
        
        plr.obj.realname = createDrawingObject("Text", {
            Center = true,
            Visible = settings.realname,
            Size = esp_table.main_settings.textSize,
            Font = esp_table.main_settings.textFont
        })
        
        plr.obj.tracer = createDrawingObject("Line", {
            Thickness = 1,
            Visible = false
        })
        
        -- Скелет
        for required, _ in next, skeleton_order do
            plr.obj["skeleton_" .. required] = createDrawingObject("Line", {
                Visible = false
            })
        end
        
        -- Chams
        if plr.chams_object then
            plr.chams_object.Adornee = model
            plr.chams_object.Enabled = not isSleeping and settings.chams
            plr.chams_object.FillColor = getRainbowColor()
            plr.chams_object.FillTransparency = settings.chams_fill_color[2]
            plr.chams_object.OutlineColor = getRainbowColor()
            plr.chams_object.OutlineTransparency = settings.chamsoutline_color[2]
        end
        
        -- Цикл обновления ESP
        plr.connection = RunService.RenderStepped:Connect(function()
            if not model or not model.Parent or not model:FindFirstChild("Head") then
                return
            end
            
            local head = model.Head
            local _, onScreen = worldToScreen(head.Position)
            
            if not onScreen then
                for _, obj in pairs(plr.obj) do
                    if obj then obj.Visible = false end
                end
                if plr.chams_object then
                    plr.chams_object.Enabled = false
                end
                return
            end
            
            local rainbowColor = getRainbowColor()
            local settings = esp_table.settings.enemy
            
            -- Обновляем видимость
            local currentPlayerId, currentIsSleeping = getPlayerIdFromModel(model)
            
            if not currentIsSleeping then
                -- Box
                if plr.obj.box then
                    plr.obj.box.Visible = settings.box
                    plr.obj.box.Color = rainbowColor
                    plr.obj.box.Transparency = settings.box_color[2]
                end
                
                if plr.obj.box_fill then
                    plr.obj.box_fill.Visible = settings.box_fill
                    plr.obj.box_fill.Color = rainbowColor
                    plr.obj.box_fill.Transparency = settings.box_fill_color[2]
                end
                
                if plr.obj.box_outline then
                    plr.obj.box_outline.Visible = settings.box_outline
                    plr.obj.box_outline.Color = settings.box_outline_color[1]
                end
                
                if plr.obj.realname then
                    plr.obj.realname.Visible = settings.realname
                    plr.obj.realname.Text = playerName
                    plr.obj.realname.Color = rainbowColor
                    plr.obj.realname.Outline = settings.realname_outline
                end
                
                if plr.obj.tracer then
                    plr.obj.tracer.Visible = settings.tracers
                    plr.obj.tracer.Color = rainbowColor
                end
                
                -- Chams
                if plr.chams_object then
                    plr.chams_object.Enabled = settings.chams
                    plr.chams_object.FillColor = rainbowColor
                    plr.chams_object.OutlineColor = rainbowColor
                end
                
                -- Скелет
                if settings.skeleton then
                    for boneName, parentName in pairs(skeleton_order) do
                        local bone = model:FindFirstChild(boneName)
                        local parent = model:FindFirstChild(parentName)
                        local skeletonObj = plr.obj["skeleton_" .. boneName]
                        
                        if bone and parent and skeletonObj then
                            local bonePos, boneOnScreen = Camera:WorldToViewportPoint(bone.Position)
                            local parentPos, parentOnScreen = Camera:WorldToViewportPoint(parent.Position)
                            
                            if boneOnScreen and parentOnScreen then
                                skeletonObj.Visible = true
                                skeletonObj.Color = rainbowColor
                                skeletonObj.From = Vector2.new(bonePos.X, bonePos.Y)
                                skeletonObj.To = Vector2.new(parentPos.X, parentPos.Y)
                            else
                                skeletonObj.Visible = false
                            end
                        end
                    end
                end
                
                -- Позиционирование
                local lowertorso = model:FindFirstChild("LowerTorso")
                if head and lowertorso then
                    local corners = calculateCornersSimple(head, lowertorso)
                    
                    if corners then
                        if plr.obj.box then
                            plr.obj.box.Position = corners.topLeft
                            plr.obj.box.Size = corners.bottomRight - corners.topLeft
                        end
                        
                        if plr.obj.box_fill then
                            plr.obj.box_fill.Position = corners.topLeft
                            plr.obj.box_fill.Size = corners.bottomRight - corners.topLeft
                        end
                        
                        if plr.obj.box_outline then
                            plr.obj.box_outline.Position = corners.topLeft + Vector2.new(1, 1)
                            plr.obj.box_outline.Size = (corners.bottomRight - corners.topLeft) - Vector2.new(1, 1)
                        end
                        
                        if plr.obj.realname then
                            plr.obj.realname.Position = corners.topLeft + 
                                (corners.topRight - corners.topLeft) / 2 - 
                                Vector2.new(0, plr.obj.realname.TextBounds.Y + 2)
                        end
                        
                        -- Трейсеры
                        if plr.obj.tracer and settings.tracers then
                            local torsoPos = worldToScreen(lowertorso.Position)
                            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            plr.obj.tracer.From = screenCenter
                            plr.obj.tracer.To = torsoPos
                        end
                    end
                end
            else
                -- Если спит
                for _, obj in pairs(plr.obj) do
                    if obj then obj.Visible = false end
                end
                if plr.chams_object then
                    plr.chams_object.Enabled = false
                end
                if plr.obj.realname then
                    plr.obj.realname.Visible = true
                    plr.obj.realname.Text = "Sleeper"
                end
            end
        end)
    end
end

local function destroy_esp(model)
    esp_players[model] = nil
    
    local plr = loaded_plrs[model]
    if plr then
        if plr.connection then
            plr.connection:Disconnect()
        end
        
        for _, obj in pairs(plr.obj) do
            if obj and obj.Remove then
                obj:Remove()
            end
        end
        
        if plr.chams_object then
            plr.chams_object:Destroy()
        end
        
        loaded_plrs[model] = nil
    end
end

-- AIMBOT ФУНКЦИИ
local function findClosestPlayer()
    if not LocalPlayer.Character then return nil end
    
    local closestPlayer = nil
    local closestDistance = currentFOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- Используем игроков из ESP системы
    for model, _ in pairs(esp_players) do
        if model and model:IsA("Model") then
            local head = model:FindFirstChild("Head")
            local humanoid = model:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local headScreenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
                
                if onScreen then
                    local distance = (Vector2.new(headScreenPos.X, headScreenPos.Y) - screenCenter).Magnitude
                    
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = model
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

local function aimAtTarget(targetModel)
    if not targetModel or not LocalPlayer.Character then return end
    
    local head = targetModel:FindFirstChild("Head")
    local humanoidRootPart = targetModel:FindFirstChild("HumanoidRootPart")
    
    if head then
        local currentCF = Camera.CFrame
        local direction = (head.Position - currentCF.Position).Unit
        local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + direction)
        
        -- Плавное наведение для мобильных устройств
        Camera.CFrame = currentCF:Lerp(targetCF, aimSmoothness)
    elseif humanoidRootPart then
        local currentCF = Camera.CFrame
        local direction = (humanoidRootPart.Position - currentCF.Position).Unit
        local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + direction)
        
        Camera.CFrame = currentCF:Lerp(targetCF, aimSmoothness)
    end
end

local function ToggleAimbot()
    aimbotEnabled = not aimbotEnabled
    
    if aimbotEnabled then
        -- Обновляем FOV круг
        if FOVCircle then
            if typeof(FOVCircle) == "table" and FOVCircle.Visible ~= nil then
                FOVCircle.Visible = showFOVCircle
                FOVCircle.Radius = currentFOV
            elseif FOVCircle:IsA("Frame") then
                FOVCircle.Visible = showFOVCircle
                FOVCircle.Size = UDim2.new(0, currentFOV * 2, 0, currentFOV * 2)
            end
        end
        
        -- Запускаем цикл AimBot
        aimbotConnection = RunService.RenderStepped:Connect(function()
            local closestPlayer = findClosestPlayer()
            if closestPlayer then
                aimAtTarget(closestPlayer)
            end
        end)
    else
        -- Выключаем
        if FOVCircle then
            if typeof(FOVCircle) == "table" and FOVCircle.Visible ~= nil then
                FOVCircle.Visible = false
            elseif FOVCircle:IsA("Frame") then
                FOVCircle.Visible = false
            end
        end
        
        if aimbotConnection then
            aimbotConnection:Disconnect()
            aimbotConnection = nil
        end
    end
end

local function UpdateFOV()
    if currentFOV < 150 then
        currentFOV = currentFOV + 10
    else
        currentFOV = 30
    end
    
    if FOVCircle then
        if typeof(FOVCircle) == "table" and FOVCircle.Radius ~= nil then
            FOVCircle.Radius = currentFOV
        elseif FOVCircle:IsA("Frame") then
            FOVCircle.Size = UDim2.new(0, currentFOV * 2, 0, currentFOV * 2)
        end
    end
end

-- МОБИЛЬНОЕ УПРАВЛЕНИЕ
local touchStartTime = 0
local touchStartPos = nil
local isTouchActive = false

UserInputService.TouchStarted:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    touchStartTime = tick()
    touchStartPos = input.Position
    isTouchActive = true
end)

UserInputService.TouchEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local touchDuration = tick() - touchStartTime
    local endPos = input.Position
    
    if touchDuration < 0.3 then
        -- Короткое нажатие - активация/деактивация AimBot
        ToggleAimbot()
    elseif touchDuration > 0.8 then
        -- Долгое нажатие - изменение FOV
        UpdateFOV()
    end
    
    isTouchActive = false
end)

